    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"llama-3.1-8b-instant\",\"response_format\":{\"type\":\"json_object\"},\"messages\":[{\"role\":\"system\",\"content\":\"Ты куратор датасета. Оцени каждый текст. Верни строго JSON {\\\"results\\\":[{\\\"i\\\":0,\\\"pass\\\":true}]}. pass=true только если текст связный, без токсичности, спама и персональных данных.\"},{\"role\":\"user\",\"content\":\"{{ $json.userContent }}\"}]}",
        "options": {}
      },
      "id": "ВАШ ID",
      "name": "Groq Curator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        704,
        400
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "ВАШ TOKEN",
          "name": "Groq key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices?.[0]?.message?.content || '{}';\nlet parsed; try { parsed = JSON.parse(raw); } catch(e) { parsed = {results:[]}; }\nconst texts = $('Clean & Dedup').first().json.texts || [];\nconst passed = (parsed.results||[]).filter(r=>r&&r.pass).map(r=>texts[r.i]).filter(t=>typeof t==='string'&&t.length>0);\nreturn [{ json: { passed } }];"
      },
      "id": "ВАШ ID",
      "name": "Parse Groq",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const passed = $input.first().json.passed || [];\nif (!passed.length) return [{ json: { count:0, name:'', b64:'' } }];\nconst jsonl = passed.map(t=>JSON.stringify({text:t})).join('\\n');\nconst b64 = Buffer.from(jsonl,'utf-8').toString('base64');\nconst name = 'batch-' + new Date().toISOString().replace(/[:T]/g,'-').replace(/\\..+/,'') + '.jsonl';\nreturn [{ json: { count: passed.length, name, b64 } }];"
      },
