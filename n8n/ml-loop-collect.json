    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet texts = [];\nfor (const it of items) {\n  const j = it.json;\n  if (j.data && Array.isArray(j.data.children)) {\n    for (const c of j.data.children) texts.push((c.data.title||'') + '. ' + (c.data.selftext||''));\n  } else if (Array.isArray(j.hits)) {\n    for (const h of j.hits) texts.push((h.title||'') + '. ' + (h.comment_text||h.story_text||''));\n  } else if (j.mostread && Array.isArray(j.mostread.articles)) {\n    for (const a of j.mostread.articles) texts.push((a.title||'') + '. ' + (a.extract||''));\n  }\n}\n\n// Нормализация: URL, HTML-теги, сущности, пробелы\ntexts = texts.map(t => (t||'').replace(/https?:\\/\\/\\S+/g,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;|&amp;|&lt;|&gt;|&#x27;|&#\\d+;/g,' ').replace(/\\s+/g,' ').trim());\n\n// Фильтры: длина и спецсимволы\ntexts = texts.filter(t => t.length >= 80 && t.length <= 2000);\ntexts = texts.filter(t => { const s=(t.match(/[^\\w\\s.,!?;:'\\\"()-]/g)||[]).length; return s/t.length < 0.2; });\n\n// Shingle-дедупликация (5 слов, порог 50%)\nfunction shingles(t){ const w=t.toLowerCase().split(' '); const s=new Set(); for(let i=0;i+5<=w.length;i++) s.add(w.slice(i,i+5).join(' ')); return s; }\nconst seen=[]; const out=[];\nfor (const t of texts) {\n  const sh = shingles(t); let dup=false;\n  for (const prev of seen) { let inter=0; for (const x of sh) if (prev.has(x)) inter++;\n    const union = sh.size + prev.size - inter;\n    if (union>0 && inter/union>0.5) { dup=true; break; } }\n  if (!dup) { seen.push(sh); out.push(t); }\n}\n\n// Безопасная строка для Groq (без двойных кавычек)\nconst safe = out.slice(0,30).map(t => t.replace(/\"/g, \"'\").trim());\nconst userContent = safe.join(\" |SEP| \");\n\nreturn [{ json: { texts: out.slice(0,30), userContent } }];"
      },
      "id": "ВАШ ID",
      "name": "Clean & Dedup",
