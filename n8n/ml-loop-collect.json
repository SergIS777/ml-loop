      "id": "9129b514-4713-46c2-b6ae-678c9a8cd7d3",
      "name": "Wiki",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        592
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet texts = [];\nfor (const it of items) {\n  const j = it.json;\n  if (j.data && Array.isArray(j.data.children)) {\n    for (const c of j.data.children) texts.push((c.data.title||'') + '. ' + (c.data.selftext||''));\n  } else if (Array.isArray(j.hits)) {\n    for (const h of j.hits) texts.push((h.title||'') + '. ' + (h.comment_text||h.story_text||''));\n  } else if (j.mostread && Array.isArray(j.mostread.articles)) {\n    for (const a of j.mostread.articles) texts.push((a.title||'') + '. ' + (a.extract||''));\n  }\n}\n\ntexts = texts.map(t => (t||'').replace(/https?:\\/\\/\\S+/g,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;|&amp;|&lt;|&gt;|&#\\d+;/g,' ').replace(/\\s+/g,' ').trim());\ntexts = texts.filter(t => t.length >= 80 && t.length <= 2000);\ntexts = texts.filter(t => { const s=(t.match(/[^\\w\\s.,!?;:'\"()-]/g)||[]).length; return s/t.length < 0.2; });\n\n// обрезка каждого текста до 700 символов — режет токены запроса к куратору (TPM-лимит)\ntexts = texts.map(t => t.slice(0, 700));\n\nfunction shingles(t){ const w=t.toLowerCase().split(' '); const s=new Set(); for(let i=0;i+5<=w.length;i++) s.add(w.slice(i,i+5).join(' ')); return s; }\nconst seen=[]; const out=[];\nfor (const t of texts) {\n  const sh = shingles(t); let dup=false;\n  for (const prev of seen) { let inter=0; for (const x of sh) if (prev.has(x)) inter++;\n    const union = sh.size + prev.size - inter;\n    if (union>0 && inter/union>0.5) { dup=true; break; } }\n  if (!dup) { seen.push(sh); out.push(t); }\n}\n\nconst safe = out.slice(0,30).map(t => t.replace(/\"/g,\"'\").trim());\nconst userContent = safe.join(\" |SEP| \");\n\nreturn [{ json: { texts: out.slice(0,30), userContent } }];"
      },
      "id": "e1c9202f-e6a2-491e-95ff-f2ff2377f8cf",
      "name": "Clean & Dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\": \"openai/gpt-oss-120b\", \"temperature\": 0.2, \"response_format\": {\"type\": \"json_object\"}, \"messages\": [{\"role\": \"system\", \"content\": \"Ты куратор датасета. Оцени каждый текст. Верни строго JSON {\\\"results\\\":[{\\\"i\\\":0,\\\"pass\\\":true}]}. pass=true только если текст связный, без токсичности, спама и персональных данных. Return ONLY valid JSON - no markdown, no explanations.\"}, {\"role\": \"user\", \"content\": \"{{ $json.userContent }}\"}]}",
        "options": {}
      },
      "id": "92d1efa8-5ee3-47ba-af0a-b735bbe37388",
      "name": "Groq Curator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        704,
        400
      ],
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpBearerAuth": {
          "id": "XLprY2l92jaR6zbW",
          "name": "Groq key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices?.[0]?.message?.content || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch(e) {\n  parsed = { results: [] };\n}\nconst texts = $('Clean & Dedup').first().json.texts || [];\nlet passed = (parsed.results||[]).filter(r=>r&&r.pass).map(r=>texts[r.i]).filter(t=>typeof t==='string'&&t.length>0);\nif (!passed.length && texts.length) passed = texts.slice(0,10);\nreturn [{ json: { passed } }];"
      },
      "id": "ffc0e753-1497-4643-a47e-332fa6818fe7",
      "name": "Parse Groq",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const passed = $input.first().json.passed || [];\nif (!passed.length) return [{ json: { count:0, name:'', b64:'' } }];\nconst jsonl = passed.map(t=>JSON.stringify({text:t})).join('\\n');\nconst b64 = Buffer.from(jsonl,'utf-8').toString('base64');\nconst name = 'batch-' + new Date().toISOString().replace(/[:T]/g,'-').replace(/\\..+/,'') + '.jsonl';\nreturn [{ json: { count: passed.length, name, b64 } }];"
      },
